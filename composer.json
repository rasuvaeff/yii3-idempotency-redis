{
    "name": "rasuvaeff/yii3-idempotency-redis",
    "description": "Redis-backed idempotency storage for Yii3 APIs",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "yii3",
        "idempotency",
        "redis",
        "storage"
    ],
    "authors": [
        {
            "name": "Victor Razuvaev",
            "email": "rasuvaeff@gmail.com"
        }
    ],
    "homepage": "https://github.com/rasuvaeff/yii3-idempotency-redis",
    "support": {
        "issues": "https://github.com/rasuvaeff/yii3-idempotency-redis/issues",
        "source": "https://github.com/rasuvaeff/yii3-idempotency-redis"
    },
    "require": {
        "php": "8.3 - 8.5",
        "psr/clock": "^1.0",
        "rasuvaeff/yii3-idempotency": "^2.2"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.51",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35",
        "maglnet/composer-require-checker": "^4.17",
        "predis/predis": "^2.2",
        "rasuvaeff/rector-named-literals": "^1.0",
        "rasuvaeff/understudy-testo": "^1.0",
        "rector/rector": "^2.4",
        "roave/backward-compatibility-check": "^8.0",
        "testo/bridge-infection": "^0.1.6",
        "testo/testo": "^0.10.25",
        "vimeo/psalm": "^6.16",
        "yiisoft/test-support": "^3.0"
    },
    "suggest": {
        "ext-redis": "Required to use PhpRedisScriptRunner",
        "predis/predis": "Required to use PredisScriptRunner (^2.2, pure-PHP alternative to ext-redis)"
    },
    "autoload": {
        "psr-4": {
            "Rasuvaeff\\Yii3IdempotencyRedis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rasuvaeff\\Yii3IdempotencyRedis\\Benchmarks\\": "benchmarks/",
            "Rasuvaeff\\Yii3IdempotencyRedis\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true
        },
        "platform": {
            "ext-bcmath": "1.0.0",
            "ext-intl": "1.0.0"
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        },
        "config-plugin": {
            "di": "di.php",
            "params": "params.php"
        },
        "config-plugin-options": {
            "source-directory": "config"
        }
    },
    "scripts": {
        "bc-check": "roave-backward-compatibility-check",
        "bench": "testo --suite=Benchmarks -vv",
        "build": [
            "@composer validate --strict",
            "@composer normalize --dry-run",
            "@require-checker",
            "@cs",
            "@psalm",
            "@test"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.php",
        "cs:fix": "php-cs-fixer fix --diff --config=.php-cs-fixer.php",
        "mutation": "infection --threads=max",
        "psalm": "psalm --no-cache",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "release-check": [
            "@build",
            "@rector",
            "@bc-check"
        ],
        "require-checker": "composer-require-checker check composer.json",
        "test": "testo --suite=Unit",
        "test:coverage": "testo --suite=Unit --coverage --coverage-clover=build/coverage.xml",
        "test:coverage:ci": "testo --suite=Unit --coverage-clover=build/coverage.xml"
    }
}
