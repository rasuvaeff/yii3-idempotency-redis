<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedCode="false"
    resolveFromConfigFile="true"
>
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>

    <!-- PhpRedisScriptRunner types against \Redis; the bundled stub lets psalm
         analyze it without ext-redis being installed. -->
    <enableExtensions>
        <extension name="redis"/>
    </enableExtensions>

    <issueHandlers>
        <!-- The script digest passed to Redis EVALSHA is defined by the Redis
             protocol: the server matches loaded scripts by their SHA1. There
             is no stronger algorithm to switch to, so the WeakHash check
             (psalm 7.15, issue #381) is a false positive here — the hash never
             covers user data. Remove this rule if psalm ever learns to exempt
             protocol-mandated digests. -->
        <WeakHash>
            <errorLevel type="suppress">
                <file name="src/Redis/PhpRedisScriptRunner.php"/>
                <file name="src/Redis/PredisScriptRunner.php"/>
            </errorLevel>
        </WeakHash>
    </issueHandlers>
</psalm>
